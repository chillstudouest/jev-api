# syntax=docker/dockerfile:1.7
# Base image for jev-api: python + build toolchain + venv + torch (CPU).
# Built and pushed to ghcr.io by .github/workflows/base-image.yml.
# Tag naming: py<major>.<minor>-torch-cpu. Bump the tag when torch/python changes.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv

# CPU wheels only — no CUDA.
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip install --upgrade pip \
 && /opt/venv/bin/pip install torch --index-url https://download.pytorch.org/whl/cpu
