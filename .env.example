# Copy to .env for local runs. Never commit real secrets.

JEV_API_KEY=dev-key-change-me
# Optional (wfzyx/von-1.0 is public):
# HF_TOKEN=hf_xxx
HF_REPO=wfzyx/von-1.0
VON_BACKEND=von
LAYA_HF_REPO=convaiinnovations/laya
# LAYA_SUBFOLDER=typed-decisions
PRELOAD_LAYA=false
AGENTJEV_HF_REPO=aimeigaoshou/agent-jev
AGENTJEV_BACKBONE=Qwen/Qwen3-0.6B
PRELOAD_AGENTJEV=false
SEMIF_HF_REPO=Qwen/Qwen3.5-4B
SEMIF_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
SEMIF_BACKEND=auto
SEMIF_MODE=auto
# SEMIF_GGUF_PATH=/path/to/Qwen_Qwen3.5-4B-Q4_K_M.gguf
PRELOAD_SEMIF=false
# djev (Maisa, diffusion-gemma) — https://github.com/Davipar/djev-dev
DJEV_BASE_URL=https://api.djev.dev
# DJEV_API_KEY=  # required for hosted Maisa API
DJEV_REMOTE_MODEL=djev
PRELOAD_DJEV=false
MODEL_CACHE_DIR=./data/models
JEV_DEVICE=cpu
HOST=0.0.0.0
PORT=8000
DOWNLOAD_ON_STARTUP=true
