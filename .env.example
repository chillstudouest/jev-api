# Copy to .env for local runs. Never commit real secrets.

JEV_API_KEY=dev-key-change-me
# Required to download the private Verdict 2.0 checkpoint from Hugging Face:
# HF_TOKEN=hf_xxx
HF_REPO=heman10x/openJev-verdict-2.0
MODEL_CACHE_DIR=./data/models
BACKBONE_DIR=./vendor/modernbert
JEV_DEVICE=cpu
HOST=0.0.0.0
PORT=8000
DOWNLOAD_ON_STARTUP=true
# Optional: skip HF download and use a local unpacked checkpoint directory
# LOCAL_CHECKPOINT_DIR=./data/models/snapshot
