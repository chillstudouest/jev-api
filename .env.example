# Copy to .env for local runs. Never commit real secrets.

JEV_API_KEY=dev-key-change-me
# Optional (wfzyx/von-1.0 is public):
# HF_TOKEN=hf_xxx
HF_REPO=wfzyx/von-1.0
VON_BACKEND=von
# onnx (default, CPU) or torch (gliner2 library, also CUDA/MPS)
GLINNER_BACKEND=onnx
# fp32 = same answers as torch; int8 = smaller, 3/120 JevBench answers differ
GLINNER_ONNX_VARIANT=fp32
# GLINNER_THREADS=4
GLINNER_HF_REPO=fastino/GLiNER2.5-Decide
PRELOAD_GLINNER=false
# Dummy decision after load + every KEEP_WARM_INTERVAL_S of idle (0 = off)
WARMUP_ON_STARTUP=true
KEEP_WARM_INTERVAL_S=45
MODEL_CACHE_DIR=./data/models
JEV_DEVICE=cpu
HOST=0.0.0.0
PORT=8000
DOWNLOAD_ON_STARTUP=true
# Official TypeSafe Jev when body.model is "jev"
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-1.13.0
